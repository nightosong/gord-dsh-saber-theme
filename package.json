{
  "name": "gord-dsh-saber-theme",
  "version": "0.3.1",
  "description": "Saber Ice Atelier theme for DeepSeek Harness Desktop and Web",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=22", "dsh": "0.2.0-rc.2 || 0.2.1-rc.2" },
  "main": "./lib/index.js",
  "files": ["lib", "cordis.patch.yml", "NOTICE.md"],
  "keywords": ["dsh-plugin", "deepseek-harness", "dsh-theme", "saber", "fate"],
  "peerDependencies": { "@deepseek-ai/dsh-client-ui-theme": "0.2.0-rc.2 || 0.2.1-rc.2" },
  "peerDependenciesMeta": { "@deepseek-ai/dsh-client-ui-theme": { "optional": true } },
  "repository": { "type": "git", "url": "https://github.com/nightosong/gord-dsh-saber-theme.git" },
  "exports": { ".": "./lib/index.js", "./client": "./lib/client.js", "./package.json": "./package.json", "./cordis.patch.yml": "./cordis.patch.yml" },
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" }, "client": { "platform": "web", "inject": ["@deepseek-ai/dsh-client-ui-theme", "@deepseek-ai/dsh-client-ui-session", "@deepseek-ai/dsh-client-ui-workspace"] } },
  "scripts": {
    "build": "node scripts/build.mjs",
    "package": "node scripts/pack.mjs",
    "prepack": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "check": "npm run build && npm test && npm run test:browser",
    "install:theme": "node scripts/manage.mjs install",
    "uninstall:theme": "node scripts/manage.mjs uninstall",
    "status": "node scripts/manage.mjs status",
    "preview": "node scripts/preview.mjs",
    "release:pack": "node scripts/release.mjs"
  },
  "devDependencies": { "@playwright/test": "1.64.1" }
}
